# Chỉ theo dõi mã, cấu hình, notebook và tài liệu dùng để tái lập.
/*
!/.gitignore
!/README.md
!/requirements.txt

!/configs/
/configs/*
!/configs/final_ridge.json
!/configs/lightgbm_finance.json

!/src/
/src/*
!/src/*.py
!/src/models/
/src/models/*
!/src/models/*.py

!/tests/
/tests/*
!/tests/test_*.py

!/scripts/
/scripts/*
!/scripts/*.py

!/notebooks/
/notebooks/*
!/notebooks/experiments/
/notebooks/experiments/*
!/notebooks/experiments/eda_stock_prices.ipynb
!/notebooks/experiments/model_comparison.ipynb
!/notebooks/experiments/liquidity_costs.ipynb
!/notebooks/experiments/financial_disclosures.ipynb
!/notebooks/jpx_overview.ipynb
!/notebooks/references/
/notebooks/references/*
!/notebooks/references/*.ipynb
/notebooks/references/easy-to-understand-the-competition.ipynb
/notebooks/references/jpx-competition-metric-definition.ipynb
!/notebooks/references/README.md
!/notebooks/references/LICENSE-APACHE-2.0.txt

!/reports/
/reports/*
!/reports/jpx_release.md
!/reports/reproduce.md
/reports/jpx_qa.md

# Dữ liệu, kết quả sinh ra và các thư mục chỉ dùng cục bộ.
/data/
/artifacts/
/JPXTokyoStockExchangePrediction/
__pycache__/
.ipynb_checkpoints/
*.py[cod]
