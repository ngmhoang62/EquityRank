{
  "model": "LightGBM finance",
  "features": [
    "Open",
    "High",
    "Low",
    "Close",
    "Volume",
    "operating_margin",
    "equity_asset_ratio",
    "margin_report_age",
    "asset_report_age",
    "margin_report_missing",
    "asset_report_missing",
    "statement_today",
    "forecast_revision_today",
    "correction_today"
  ],
  "parameters": {
    "n_estimators": 100,
    "learning_rate": 0.05,
    "n_jobs": 4,
    "random_state": 7,
    "num_leaves": 15,
    "min_child_samples": 500,
    "max_bin": 63,
    "deterministic": true,
    "force_col_wise": true,
    "verbosity": -1
  }
}
